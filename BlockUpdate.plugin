#!name =  No-Ios and MacOS: 📍❌
#!desc = 自定义「拒绝ios和MacOS更新」\n通过「基于网络规则」结果始终为用户拒绝更新,\n如果需要请自行关闭.\n⚠️ 注意事项：屏蔽这些域名后，你的设备可能无法检查/下载系统更新。
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Reject.png
#!tag =  IOS and MacOS
#!date=2023-09-26 10:52:05

# ===================各个屏蔽地址Shadowrocket/Surge通用==========================
# 只有 IOS 屏蔽地址
# Shadowrocket url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Shadowrocket/BlockUpdate.sgmodule
# 集合有 IOS/MAC OS 和各个软件 屏蔽地址
# Shadowrocket url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Shadowrocket/NO-Update.sgmodule
# Loon url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Loon/BlockUpdate.plugin
# QuantumultX url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/quantumult-x/BlockUpdate.list
# Stash重写屏蔽🍎IOS https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Stash/BlockUpdate.stoverride
# Stash规则屏蔽🍎IOS https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Stash/BlockUpdate.yaml

[Rule]
# 🍎 统更新检查 的核心域名
DOMAIN,mesu.apple.com,REJECT
# 🍎 配置文件 / 描述文件
DOMAIN,gdmf.apple.com,REJECT
# 🍎 系统更新 CDN
DOMAIN,updates-http.cdn-apple.com,REJECT
# 🍎 诊断 & 更新反馈
# DOMAIN,xp.apple.com,REJECT
# 🍎 也常用于下载更新内容。
DOMAIN,appldnld.apple.com,REJECT

# 🍎 屏蔽mac系统更新
# 🍎iOS 和 macOS 都会用到，主要是下载 更新镜像 / 固件。
DOMAIN,swscan.apple.com,REJECT
# 🍎主要用于 macOS 更新内容分发。
DOMAIN,swdist.apple.com,REJECT
DOMAIN,swcdn.apple.com,REJECT
# 🍎 macOS 系统更新查询。
DOMAIN,swquery.apple.com,REJECT
# 🍎 软件更新扫描（非常关键）。
DOMAIN,swdownload.apple.com,REJECT

# 屏蔽One Switch快捷开关系统更新 24-02-22

DOMAIN-suffix,paddle.com,REJECT
DOMAIN-suffix,paddle.s3.amazonaws.com,REJECT
DOMAIN-suffix,fireball.studio,REJECT
DOMAIN-suffix,in.appcenter.ms,REJECT

# 屏蔽MenubarX Pro快捷开关系统更新 24-04-2
# DOMAIN-suffix,menubarx.app,REJECT

# 屏蔽APP Cleaner卸载软件系统更新 24-02-22
DOMAIN-suffix,download.nektony.com,REJECT

# 屏蔽CleanMY MAC清理软件系统更新 24-02-22
DOMAIN-suffix,updates.devmate.com,REJECT

# 屏蔽Adobe Acrobat Pro DC 23.006.20320 软件系统更新 24-03-28
DOMAIN-suffix,ic.adobe.io,REJECT
DOMAIN-suffix,crs.cr.adobe.com,REJECT
DOMAIN-suffix,ims-prod06.adobelogin.com,REJECT
DOMAIN-suffix,lcs-cops.adobe.io.com,REJECT
DOMAIN-suffix,4vzokhpsbs.adobe.io,REJECT

# 屏蔽BetterMouse软件自动更新
DOMAIN-suffix,api.appcenter.ms,REJECT

# 屏蔽Aldente充电管家软件自动更新
DOMAIN-suffix,apphousekitchen.com,REJECT

# 屏蔽finalshell离线更新地址域名240903可以⏰直接使用直装版解决激活码问题入口:FinalShell.callmy.cn
DOMAIN,dkys.org,REJECT
DOMAIN,youtusoft.com,REJECT
DOMAIN,hostbuf.com,REJECT
DOMAIN,tcpspeed.com,REJECT
DOMAIN,wn1998.com,REJECT

# 屏蔽Istat系统监控软件更新 240907
DOMAIN,updates.istatmenus.app,REJECT

# 屏蔽Folder Colorizer软件更新
DOMAIN,api.softorino.com,REJECT

# 屏蔽Parallels Desktop软件更新 24-09-08
DOMAIN,update.parallels.com,REJECT
DOMAIN,download.parallels.com,REJECT
DOMAIN,update.update.parallels.cn,REJECT

# 屏蔽 Boom 3D音频增强App软件更新24-09-20
DOMAIN,apiboom3.globaldelight.net,REJECT

# 屏蔽 Final App软件更新24-09-30
DOMAIN,hostbuf.com,REJECT

# 屏蔽bartender5
DOMAIN-SUFFIX,macbartender.com,REJECT

# 屏蔽 PopClip 更新
DOMAIN,softwareupdate.pilotmoon.com,REJECT

# 屏蔽 WPS 广告与联网验证
DOMAIN-SUFFIX,wps.cn,REJECT
DOMAIN-SUFFIX,wpscdn.cn,REJECT
DOMAIN-SUFFIX,ksord.com,REJECT
DOMAIN-SUFFIX,kingsoft-office-service.com,REJECT
DOMAIN,account.wps.cn,REJECT
DOMAIN,drive.wps.cn,REJECT
DOMAIN,docteamapi.wps.cn,REJECT
DOMAIN,honeycomb.wps.cn,REJECT
DOMAIN,ic.wps.cn,REJECT
DOMAIN,store1.wps.cn,REJECT
DOMAIN,ups.wps.cn,REJECT
DOMAIN,notify.wps.cn,REJECT
DOMAIN,android.wps.cn,REJECT
DOMAIN,mac.wpscdn.cn,REJECT
DOMAIN,push.wps.cn,REJECT
DOMAIN,api.kingsoft-office-service.com,REJECT
DOMAIN,shuc-other.ksord.com,REJECT
DOMAIN,shuc-normal.ksord.com,REJECT
DOMAIN,shuc-api.ksord.com,REJECT
DOMAIN,cloudservice19.kingsoft-office-service.com,REJECT

# 抖音追踪屏蔽规则
DOMAIN-SUFFIX,snssdk.com,REJECT
DOMAIN-SUFFIX,bytegs.com,REJECT
















