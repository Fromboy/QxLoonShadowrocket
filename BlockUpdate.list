#!name=屏蔽系统更新
#!desc=屏蔽 iOS 系统更新。
#!date=2023-09-26 10:52:05

# ===================各个屏蔽地址Shadowrocket/Surge通用==========================
# 只有 IOS 屏蔽地址
# Shadowrocket url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Shadowrocket/BlockUpdate.sgmodule
# 集合有 IOS/MAC OS 和各个软件 屏蔽地址
# Shadowrocket url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Shadowrocket/NO-Update.sgmodule
# Loon url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Loon/BlockUpdate.plugin
# QuantumultX url=https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/quantumult-x/BlockUpdate.list
# Stash重写屏蔽🍎IOS https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Stash/BlockUpdate.stoverride
# Stash规则屏蔽🍎IOS https://raw.githubusercontent.com/Fromboy/QxLoonShadowrocket/Stash/BlockUpdate.yaml

# [Rule]
# 🍎 核心更新检查
host,mesu.apple.com,REJECT
# 配置文件 / 描述文件
host,gdmf.apple.com,REJECT
# 🍎 系统更新 CDN
host,updates-http.cdn-apple.com,REJECT
# 🍎 常用下载域名
host-suffix,appldnld.apple.com,REJECT

# 屏蔽mac系统更新
# 🍎 iOS 和 macOS 都会用到，主要是下载 更新镜像 / 固件
host-suffix,appldnld.apple.com,REJECT
# 🍎 主要用于 macOS 更新内容分发。
host-suffix,swcdn.apple.com,REJECT
# 🍎 macOS 系统更新下载。
host-suffix,swdownload.apple.com,REJECT
# 🍎 系统更新查询。
host-suffix,swquery.apple.com,REJECT
# 🍎 软件更新扫描（非常关键）。
host-suffix,swscan.apple.com,REJECT

# 屏蔽One Switch快捷开关系统更新 24-02-22
